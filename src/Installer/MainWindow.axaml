<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BigWalkVRInstaller"
        x:Class="BigWalkVRInstaller.MainWindow"
        Title="Big Walk VR Installer"
        Width="740" Height="700" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Inter"
        Icon="avares://BigWalkVRInstaller/Assets/icon.png">

    <Window.Resources>
        <DataTemplate x:Key="ModCard">
            <Border Theme="{StaticResource Card}" Padding="16,13">
                <Grid>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Theme="{StaticResource Tag}" Padding="6,1" Margin="8,0,0,0"
                                            Background="{StaticResource AmberFill}" BorderBrush="{StaticResource AmberFillBorder}"
                                            IsVisible="{Binding HasChannel}">
                                        <TextBlock Text="{Binding ChannelTag}" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Amber}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                           Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                           IsVisible="{Binding HasDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <Button Theme="{StaticResource QuietDanger}" Content="Uninstall" FontSize="11.5"
                                        Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Click="Uninstall_Click" IsVisible="{Binding ShowUninstall}" />
                                <!-- install or update button, or the Installed chip, joined to the release channel dropdown -->
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding !Busy}">
                                    <Button Theme="{StaticResource Primary}" Content="{Binding ActionLabel}" Padding="18,7"
                                            Classes.joined="{Binding ShowChannels}"
                                            Click="Install_Click" IsVisible="{Binding !IsInstalled}" />
                                    <Button Theme="{StaticResource Update}" Content="{Binding ActionLabel}" Padding="18,7"
                                            Classes.joined="{Binding ShowChannels}"
                                            Click="Install_Click" IsVisible="{Binding CanUpdate}" />
                                    <Border Theme="{StaticResource StatusChip}" Classes.joined="{Binding ShowChannels}"
                                            IsVisible="{Binding IsCurrent}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource CheckGlyph}" Stroke="{StaticResource Green}"
                                                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="15" Height="14" Stretch="None"
                                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="Installed" Foreground="{StaticResource Green}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Button Theme="{StaticResource ChannelsButton}" Click="Channels_Click"
                                            Classes.update="{Binding CanUpdate}" Classes.installed="{Binding IsCurrent}"
                                            IsVisible="{Binding ShowChannels}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,2" IsVisible="{Binding Busy}">
                            <TextBlock Text="{Binding BusyText}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                            <ProgressBar Theme="{StaticResource Progress}" Value="{Binding Progress}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- corner badge marking a mod with a pending update -->
                    <Border Width="21" Height="21" CornerRadius="11" Background="{StaticResource Amber}"
                            BorderBrush="{StaticResource Bg}" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0"
                            ToolTip.Tip="{Binding UpdateLabel}" IsVisible="{Binding ShowUpdate}">
                        <Path Data="{StaticResource UpdateGlyph}" Stroke="{StaticResource Bg}" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="14" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="46,Auto,Auto,*,Auto">

        <!-- titlebar -->
        <Grid Grid.Row="0" Name="TitleBar" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="avares://BigWalkVRInstaller/Assets/icon.png" Width="20" Height="20"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Big Walk VR Installer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Name="VersionText" FontSize="11" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="10,1,0,0" />
            </StackPanel>
        </Grid>

        <!-- nav -->
        <Grid Grid.Row="1" Margin="18,4,18,12">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Name="NavInstall" Theme="{StaticResource NavPill}" Content="Setup"
                                 GroupName="nav" IsChecked="True" IsCheckedChanged="Nav_Changed" />
                    <RadioButton Name="NavLogs" Theme="{StaticResource NavPill}" Content="Logs" GroupName="nav"
                                 Margin="3,0,0,0" IsCheckedChanged="Nav_Changed" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Theme="{StaticResource Ghost}" Content="Refresh" Click="Refresh_Click" />
                <Button Name="LaunchNonVrButton" Theme="{StaticResource Secondary}" Content="Launch in Non-VR"
                        Padding="18,7" Margin="8,0,0,0" Click="LaunchNonVr_Click"
                        ToolTip.Tip="Play normally while seeing VR players' tracked movement" />
                <Button Name="LaunchButton" Theme="{StaticResource Primary}" Content="Launch in VR"
                        Padding="18,7" Margin="8,0,0,0" Click="Launch_Click"
                        ToolTip.Tip="Launch Big Walk in VR. SteamVR is started for you if it isn't already." />
            </StackPanel>
        </Grid>

        <!-- installer update banner, only up when a newer build exists -->
        <Border Name="SelfUpdateBanner" Grid.Row="2" Theme="{StaticResource InfoPanel}" Margin="18,0,18,12"
                Padding="16,12" Background="{StaticResource AmberFill}"
                BorderBrush="{StaticResource AmberFillBorder}" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Grid.Column="0" Data="{StaticResource UpdateGlyph}" Stroke="{StaticResource Amber}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="14"
                      Stretch="None" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Name="SelfUpdateTitle" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Name="SelfUpdateButton" Grid.Column="2" Theme="{StaticResource Update}"
                        Content="Update now" Padding="18,7" VerticalAlignment="Center" Click="SelfUpdate_Click" />
            </Grid>
        </Border>

        <!-- content -->
        <Grid Grid.Row="3" Margin="18,0,18,0">

            <!-- viewport runs 10px wider than the cards so corner badges are not clipped -->
            <ScrollViewer Name="InstallView" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
                <StackPanel Margin="0,0,10,0">

                    <!-- step 1, game folder -->
                    <Border Theme="{StaticResource CardStatic}" Padding="16,13">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Name="GameBadge" Grid.Column="0" Theme="{StaticResource StepBadge}">
                                <TextBlock Name="GameBadgeText" Text="1" Tag="1" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Find Big Walk" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Name="GamePathText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Name="OpenFolderButton" Theme="{StaticResource Ghost}" Content="Open"
                                        Padding="14,7" Click="OpenGameFolder_Click" />
                                <Button Name="ChangeFolderButton" Theme="{StaticResource Ghost}" Content="Change"
                                        Padding="14,7" Margin="8,0,0,0" Click="ChangeGamePath_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- step 2, BepInEx -->
                    <Border Theme="{StaticResource CardStatic}" Padding="16,13">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Name="BepInExBadge" Grid.Column="0" Theme="{StaticResource StepBadge}">
                                    <TextBlock Name="BepInExBadgeText" Text="2" Tag="2" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Set up BepInEx" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Name="BepInExText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Name="BepInExButton" Grid.Column="2" Theme="{StaticResource Primary}" Padding="18,7"
                                        VerticalAlignment="Center" Click="InstallBepInEx_Click" />
                            </Grid>
                            <StackPanel Name="BepInExProgressPanel" Margin="0,12,0,2" IsVisible="False">
                                <TextBlock Name="BepInExProgressText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           Margin="0,0,0,6" />
                                <ProgressBar Name="BepInExProgress" Theme="{StaticResource Progress}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- step 3, the Linux-only bit: Wine has to be told to load BepInEx's winhttp.dll -->
                    <Border Theme="{StaticResource CardStatic}" Padding="16,13">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Name="ProtonBadge" Grid.Column="0" Theme="{StaticResource StepBadge}">
                                    <TextBlock Name="ProtonBadgeText" Text="3" Tag="3" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Let Proton load the mod loader" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Name="ProtonText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Name="ProtonCopyButton" Theme="{StaticResource Ghost}" Content="Copy launch options"
                                            Padding="14,7" Margin="0,0,8,0" Click="CopyLaunchOptions_Click"
                                            ToolTip.Tip="Paste this into Steam &#x2192; Big Walk &#x2192; Properties &#x2192; Launch Options if you would rather not have the prefix edited" />
                                    <Button Name="ProtonButton" Theme="{StaticResource Primary}" Content="Apply"
                                            Padding="18,7" Click="ApplyProton_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- step 4, the mods themselves -->
                    <Grid Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Name="ModsBadge" Theme="{StaticResource StepBadge}">
                                <TextBlock Name="ModsBadgeText" Text="4" Tag="4" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Install mods" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Name="ModsList" ItemTemplate="{StaticResource ModCard}" ClipToBounds="False" />

                    <TextBlock Name="OfflineNotice" Text="Couldn't reach the download list. Check your connection and press Refresh."
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,20,0,0"
                               TextWrapping="Wrap" IsVisible="False" />

                    <!-- footer help -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Theme="{StaticResource Quiet}" Content="Discord" FontSize="11.5" Padding="6,3"
                                Click="OpenDiscord_Click" ToolTip.Tip="Questions about the mod itself" />
                        <TextBlock Text="&#x2022;" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Theme="{StaticResource Quiet}" Content="GitHub" FontSize="11.5" Padding="6,3"
                                Click="OpenRepo_Click" />
                        <TextBlock Text="&#x2022;" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Theme="{StaticResource Quiet}" Content="Mod logs" FontSize="11.5" Padding="6,3"
                                Click="OpenModLogs_Click" ToolTip.Tip="BepInEx/LogOutput.log in the game folder" />
                        <TextBlock Text="&#x2022;" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Theme="{StaticResource Quiet}" Content="Prefix" FontSize="11.5" Padding="6,3"
                                Click="OpenPrefix_Click" ToolTip.Tip="Open the Proton prefix Steam built for Big Walk" />
                        <TextBlock Text="&#x2022;" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Name="CrashReportButton" Theme="{StaticResource Quiet}" Content="Create crash report"
                                FontSize="11.5" Padding="6,3" Click="CreateCrashReport_Click"
                                ToolTip.Tip="Zip up the BepInEx and Unity logs to share on the Discord" />
                        <TextBlock Text="&#x2022;" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Name="RestoreVanillaButton" Theme="{StaticResource QuietDanger}" Content="Restore vanilla"
                                FontSize="11.5" Padding="6,3" Click="RestoreVanilla_Click"
                                ToolTip.Tip="Remove every installed BepInEx mod, the loader, and the Proton override" />
                    </WrapPanel>

                    <local:SupportFooter Margin="0,26,0,18" SupportClicked="OpenSupport_Click" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Name="LogsView" VerticalScrollBarVisibility="Auto" IsVisible="False">
                <ItemsControl Name="LogsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           FontFamily="DejaVu Sans Mono,Liberation Mono,monospace" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{Binding Color}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- bottom bar -->
        <Grid Grid.Row="4" Margin="18,12,18,14">
            <TextBlock Name="StatusText" FontSize="11.5" Foreground="{StaticResource TextDim}" MaxLines="1"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,10,0" />
        </Grid>

        <!-- launch progress, explains the one-time il2cpp regen when it happens -->
        <Border Name="LaunchOverlay" Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource Scrim}" IsVisible="False">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*">
                        <Ellipse Grid.Column="0" Width="26" Height="26" Stroke="{StaticResource Accent}"
                                 StrokeThickness="3" StrokeDashArray="6,20" StrokeLineCap="Round"
                                 RenderTransformOrigin="50%,50%" VerticalAlignment="Center" Margin="0,0,15,0">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.1" IterationCount="Infinite">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="RotateTransform.Angle" Value="0" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="RotateTransform.Angle" Value="360" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Name="LaunchTitle" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Name="LaunchDescription" FontSize="12" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="False" />
                        </StackPanel>
                    </Grid>

                    <Border Name="GenPanel" Theme="{StaticResource InfoPanel}" Margin="0,16,0,0" Padding="14,12"
                            IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Name="GenCheck" Grid.Column="0" Data="{StaticResource CheckGlyph}"
                                  Stroke="{StaticResource Green}" StrokeThickness="2" StrokeLineCap="Round"
                                  StrokeJoin="Round" Width="15" Height="14" Stretch="None"
                                  VerticalAlignment="Center" Margin="0,0,11,0" IsVisible="False" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Name="GenTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Name="GenText" FontSize="12" Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Theme="{StaticResource Ghost}" Content="Stop" Padding="16,7" Margin="0,18,0,0"
                            HorizontalAlignment="Right" Click="LaunchStop_Click" />
                </StackPanel>
            </Border>
        </Border>

        <!-- themed confirm, replaces the system message box -->
        <Border Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource Scrim}" IsVisible="False">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="400"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Name="ConfirmTitle" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Name="ConfirmText" FontSize="12.5" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Name="ConfirmCancel" Theme="{StaticResource Ghost}" Content="Cancel" Padding="16,7"
                                Click="ConfirmCancel_Click" />
                        <Button Name="ConfirmOk" Theme="{StaticResource Danger}" Padding="16,7" Margin="8,0,0,0"
                                Click="ConfirmOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
